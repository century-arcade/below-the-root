   "group": "pense"
  },
  {
   "n": 105,
   "addr": "4d39",
   "text": "THE NEKOM WILL PAY ME WELL",
   "group": "pense"
  },
  {
   "n": 106,
   "addr": "4d54",
   "text": "LOOK BELOW",
   "group": "pense"
  },
  {
   "n": 107,
   "addr": "4d5f",
   "text": "THE HERMIT: EARN D'OL NESHOM'S BLESSING",
   "group": "speech"
  },
  {
   "n": 108,
   "addr": "4d87",
   "text": "SEEK A SKY-NID AND A DREAM",
   "group": "pense"
  },
  {
   "n": 109,
   "addr": "4da2",
   "text": "D'OL NESHOM: MY BLESSING QUESTER",
   "group": "speech"
  },
  {
   "n": 110,
   "addr": "4dc3",
   "text": "I GRANT YOU THE SPIRIT BELL",
   "group": "speech"
  },
  {
   "n": 111,
   "addr": "4ddf",
   "text": "YOU CAN RAISE THE FALLEN SPIRIT LEADER",
   "group": "pense"
  },
  {
   "n": 112,
   "addr": "4e06",
   "text": "VATAR: MAY THE SPIRIT SUSTAIN YOU",
   "group": "speech"
  },
  {
   "n": 113,
   "addr": "4e28",
   "text": "ONLY THE SPIRIT BELL CAN GUIDE YOU",
   "group": "pense"
  },
  {
   "n": 114,
   "addr": "4e4b",
   "text": "WANT TO PLAY?",
   "group": "speech"
  },
  {
   "n": 115,
   "addr": "4e59",
   "text": "HELLO, QUESTER",
   "group": "speech"
  },
  {
   "n": 116,
   "addr": "4e68",
   "text": "I LOST MY TOKEN",
   "group": "speech"
  },
  {
   "n": 117,
