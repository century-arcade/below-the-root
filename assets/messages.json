   "group": "pense"
  },
  {
   "n": 98,
   "addr": "4ca0",
   "text": "MIND BLOCKING",
   "group": "pense"
  },
  {
   "n": 99,
   "addr": "4cae",
   "text": "LET YOUR OWN KIND FEED YOU",
   "group": "pense"
  },
  {
   "n": 100,
   "addr": "4cc9",
   "text": "DREAM IN THE SKY",
   "group": "pense"
  },
  {
   "n": 101,
   "addr": "4cda",
   "text": "SEEK ELSEWHERE",
   "group": "pense"
  },
  {
   "n": 102,
   "addr": "4ce9",
