   "group": "speech"
  },
  {
   "n": 57,
   "addr": "489d",
   "text": "RAAMO'S MOTHER: SEEK THE SPIRIT",
   "group": "speech"
  },
  {
   "n": 58,
   "addr": "48bd",
   "text": "ENTER QUESTER",
   "group": "speech"
  },
  {
   "n": 59,
   "addr": "48cb",
   "text": "WELCOME TO MY HUMBLE ABODE",
   "group": "speech"
  },
  {
   "n": 60,
   "addr": "48e6",
   "text": "I HAVE NOTHING TO OFFER YOU",
   "group": "speech"
  },
  {
   "n": 61,
   "addr": "4902",
   "text": "ARE THERE NO ERDLING QUESTERS?",
   "group": "speech"
  },
  {
   "n": 62,
   "addr": "4921",
   "text": "I HAVE NOTHING TO GIVE",
   "group": "speech"
  },
  {
   "n": 63,
   "addr": "4938",
   "text": "YOU HAVE MY BLESSING",
   "group": "speech"
  },
  {
   "n": 64,
   "addr": "494d",
   "text": "WE WOULD NEED NO QUEST IF PEOPLE",
   "group": "speech"
  },
  {
   "n": 65,
   "addr": "496e",
   "text": "STAYED WHERE THEY BELONG",
   "group": "speech"
  },
  {
   "n": 66,
   "addr": "4987",
   "text": "THERE MUST BE SOME MISTAKE",
   "group": "speech"
  },
  {
   "n": 67,
   "addr": "49a2",
   "text": "THIS IS A KINDAR HOME",
   "group": "speech"
  },
  {
   "n": 68,
   "addr": "49b8",
   "text": "I GAVE AT THE TEMPLE",
   "group": "speech"
  },
  {
   "n": 69,
   "addr": "49cd",
   "text": "I HAVE NO TOKENS FOR KINDAR",
   "group": "speech"
  },
  {
   "n": 70,
   "addr": "49e9",
   "text": "SORRY, WE HAVE JUST EATEN",
   "group": "speech"
  },
  {
   "n": 71,
   "addr": "4a03",
   "text": "SEEK THE FORGOTTEN CHAMBER ON TEMPLE",
   "group": "pense"
  },
  {
   "n": 72,
   "addr": "4a28",
   "text": "LAMP. IT SHINES WITHOUT END",
   "group": "speech"
  },
  {
   "n": 73,
   "addr": "4a44",
   "text": "SEEK HIGH AND LOW",
   "group": "pense"
  },
  {
   "n": 74,
   "addr": "4a56",
   "text": "YOU WILL HEAR NOTHING FROM ME",
   "group": "pense"
  },
  {
   "n": 75,
   "addr": "4a74",
   "text": "THE ELIXER WILL STRENGTHEN YOU",
   "group": "pense"
  },
  {
   "n": 76,
   "addr": "4a93",
   "text": "I DON'T TRUST KINDAR",
   "group": "pense"
  },
  {
   "n": 77,
   "addr": "4aa8",
   "text": "ROPES WILL TAKE YOU TO SKY GRUND TOP",
   "group": "pense"
  },
  {
   "n": 78,
   "addr": "4acd",
   "text": "BE OFF, KINDAR",
   "group": "pense"
  },
  {
   "n": 79,
   "addr": "4adc",
   "text": "THE QUEST IS HOPELESS",
   "group": "pense"
  },
  {
   "n": 80,
   "addr": "4af2",
   "text": "THE OLD WAYS WERE BETTER",
   "group": "pense"
  },
  {
   "n": 81,
   "addr": "4b0b",
   "text": "MY NEIGHBORS ARE UNTRUSTWORTHY",
   "group": "pense"
  },
  {
   "n": 82,
   "addr": "4b2a",
   "text": "GO AWAY",
   "group": "pense"
  },
  {
   "n": 83,
   "addr": "4b32",
   "text": "SLEEP WELL, FOOL",
   "group": "pense"
  },
  {
   "n": 84,
   "addr": "4b43",
   "text": "FIND THE WISE CHILD OF THE GARDEN",
   "group": "speech+pense"
  },
  {
   "n": 85,
   "addr": "4b65",
   "text": "MAY NESHOM BLESS YOU",
   "group": "pense"
  },
  {
   "n": 86,
   "addr": "4b7a",
   "text": "I HAVE NO FAITH IN YOUR QUEST",
   "group": "pense"
  },
  {
   "n": 87,
   "addr": "4b98",
   "text": "YOU WILL GET NO HELP FROM ME",
   "group": "pense"
  },
  {
   "n": 88,
   "addr": "4bb5",
   "text": "D'OL SOLAAT'S MEN ARE WAITING",
   "group": "pense"
  },
  {
   "n": 89,
   "addr": "4bd3",
   "text": "BEWARE OF MY NEIGHBORS",
   "group": "pense"
  },
  {
   "n": 90,
   "addr": "4bea",
   "text": "BEWARE OF SNAKES",
   "group": "pense"
  },
  {
   "n": 91,
   "addr": "4bfb",
   "text": "CAN AN ERDLING BE TRUSTED?",
   "group": "pense"
  },
  {
   "n": 92,
   "addr": "4c16",
   "text": "DON'T WORRY.  HAVE A BERRY",
   "group": "pense"
  },
  {
   "n": 93,
   "addr": "4c31",
   "text": "I NEED A SHUBA",
   "group": "pense"
  },
  {
   "n": 94,
