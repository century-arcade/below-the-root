   "text": "I HAD PAN FOR LUNCH",
   "group": "speech"
  },
  {
   "n": 118,
   "addr": "4e8c",
   "text": "FIND THE WISE ONE",
   "group": "speech"
  },
  {
   "n": 119,
   "addr": "4e9e",
   "text": "RAAMO'S MOTHER CAN HELP YOU",
   "group": "pense"
  },
  {
   "n": 120,
   "addr": "4eba",
   "text": "D'FALLA AWAITS YOU",
   "group": "speech"
  },
  {
   "n": 121,
   "addr": "4ecd",
   "text": "D'OL FALLA: SEEK THE FORGOTTEN KEY",
   "group": "speech"
  },
  {
   "n": 122,
   "addr": "4ef0",
   "text": "IT NOW BELONGS TO YOU",
   "group": "speech"
  },
  {
   "n": 123,
   "addr": "4f06",
   "text": "THE FORGOTTEN CHAMBER IS NEAR",
   "group": "pense"
  },
  {
   "n": 124,
   "addr": "4f24",
   "text": "RAAMO: MAY THE SPIRIT BLESS YOU",
   "group": "speech"
  },
  {
   "n": 125,
   "addr": "4f44",
   "text": "I NEED A ROPE OR A SHUBA",
   "group": "pense"
  },
  {
   "n": 126,
   "addr": "4f5d",
   "text": "I'M AFRAID OF FALLING",
   "group": "speech"
  },
  {
   "n": 127,
   "addr": "4f73",
   "text": "ONLY A TOKEN",
   "group": "speech"
  },
  {
   "n": 128,
   "addr": "4f80",
   "text": "THE QUESTER ADMIRES MY VOICE",
   "group": "pense"
  },
  {
   "n": 129,
   "addr": "4f9d",
   "text": "RAISE YOUR SPIRIT IN THE GARDEN",
   "group": "speech"
  },
  {
   "n": 130,
   "addr": "4fbd",
   "text": "SEARCH THE HEIGHTS OF GRAND GRUND",
   "group": "speech"
  },
  {
   "n": 131,
   "addr": "4fdf",
   "text": "I HEARD A VOICE CALLING FROM BELOW",
   "group": "speech"
  },
  {
   "n": 132,
   "addr": "5002",
   "text": "FEAR",
   "group": "emotion"
  },
  {
   "n": 133,
   "addr": "5007",
   "text": "SOMEONE MUST BE LOST DOWN THERE",
   "group": "pense"
  },
  {
   "n": 134,
   "addr": "5027",
   "text": "ENTER WITH THE TEMPLE KEY",
   "group": "pense"
  },
  {
   "n": 135,
   "addr": "5041",
   "text": "*",
   "group": "unused"
  },
  {
   "n": 136,
   "addr": "5043",
   "text": "YOU SHOULD CARRY A ROPE AND A BEAK",
   "group": "pense"
  },
  {
   "n": 137,
   "addr": "5066",
   "text": "SEEK THE HERMIT OF GRAND GRUND",
   "group": "speech+pense"
  },
  {
   "n": 138,
   "addr": "5085",
   "text": "PEACE TO YOU PILGRIM",
   "group": "speech"
  },
  {
   "n": 139,
   "addr": "509a",
   "text": "MAY I SEE YOUR PASS?",
   "group": "speech"
  },
  {
   "n": 140,
   "addr": "50af",
   "text": "I'D SETTLE FOR SOME GOOD BERRY",
   "group": "pense"
  },
  {
   "n": 141,
   "addr": "50ce",
   "text": "PITY",
   "group": "emotion"
  },
  {
   "n": 142,
   "addr": "50d3",
   "text": "WAIT A MINUTE.  I WANT TOKENS.",
   "group": "speech"
  },
  {
   "n": 143,
   "addr": "50f2",
   "text": "I HOPE YOUR STAMINA IS HIGH",
   "group": "pense"
  },
  {
   "n": 144,
   "addr": "510e",
   "text": "GATHER BERRIES ON BRANCH ENDS",
   "group": "pense"
  },
  {
   "n": 145,
   "addr": "512c",
   "text": "THE SPIRIT FADES, IN DARKNESS LYING",
   "group": "speech"
  },
  {
   "n": 146,
   "addr": "5150",
   "text": "A QUEST PROCLAIM!  THE LIGHT IS DYING",
   "group": "speech"
  },
  {
   "n": 147,
   "addr": "5176",
   "text": "CLIMB AT THE BASE OF THE CENTER TRUNK",
   "group": "pense"
  },
  {
   "n": 148,
   "addr": "519c",
   "text": "SEEK THE LOST KEY ABOVE",
   "group": "pense"
  },
  {
   "n": 149,
   "addr": "51b4",
   "text": "MY SON LIVES. YOU MUST SAVE HIM",
   "group": "pense"
  },
  {
   "n": 150,
   "addr": "51d4",
   "text": "THE WISE CHILD: THE BLESSED ONE LIVES",
   "group": "speech"
  },
  {
   "n": 151,
   "addr": "51fa",
   "text": "THE SPIRIT RISES WITHIN",
   "group": "pense"
  },
  {
   "n": 152,
   "addr": "5212",
   "text": "WARMTH",
   "group": "emotion"
  },
  {
   "n": 153,
   "addr": "5219",
   "text": "PASS THE TWO GATES OF THE FORGOTTEN",
   "group": "speech"
  },
  {
   "n": 154,
   "addr": "523d",
   "text": "D'OL FALLA'S KEY IS WELL HIDDEN",
   "group": "pense"
  },
  {
   "n": 155,
   "addr": "525d",
   "text": "FIND THOSE WHO WILL RAISE YOUR SPIRIT",
   "group": "pense"
  },
  {
   "n": 156,
   "addr": "5283",
