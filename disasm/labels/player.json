 "comments": {
  "a000": "runs once per frame from the raster IRQ at line $DE",
  "a02d": "one state step, every $0A06 frames",
  "9d90": "tile code in A -> $0A2C support / $0A2D solid / $0A2E climbable",
  "9cfd": "fills $0A20-$0A2A with the 11 cells around the player",
  "a167": "ladder halves $B4/$B7 and $B6/$B9 pull the player to the centre column",
  "a2a3": "leap dy by phase; index 0 is the JMP operand, phases start at 1",
  "a587": "returns Z=1 for the wall tiles $07/$08/$52",
  "a53d": "wall in the body or head cell: revert and request a knock-down",
  "0a09": "rows fallen; $0A or more forces the knock-down at $A339",
  "8172": "returns A=1 iff fire is held -- that is what selects $A07E over $A0E7",
  "9df6": "resting pose only; the moving states set $C3F8 themselves"
 }
