  "a790": "A = object number -> Y = class 0-14; $FF matches nothing",
  "afd4": "Y = class; 16 chars from $AFF7 to ($80); $A8 set forces reverse video",
  "afc9": "Y = class; $0A7A -= item_weight[Y]",
